{
  "name": "grp-protocol",
  "version": "0.0.0",
  "private": true,
  "description": "Group Resolution Protocol — specification, CLI, SDK, verification stack, conformance suite, and docs.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "postcss": "8.5.26",
    "next": "15.5.24",
    "sharp": "0.35.4",
    "hono": "4.13.9",
    "fast-uri": "3.1.8",
    "qs": "6.16.0",
    "speech-rule-engine": {
      "@xmldom/xmldom": "0.9.12"
    },
    "yaml": "2.8.4"
  },
  "workspaces": ["packages/*", "apps/docs"],
  "scripts": {
    "build": "npm run docs:check && npm run build --workspaces --if-present",
    "test": "npm run test:repository-boundary && npm run test:release && npm run test:coordination-contract && npm run test --workspaces --if-present",
    "contract:candidate:generate": "node scripts/generate-coordination-contract.mjs",
    "contract:candidate:check": "node scripts/generate-coordination-contract.mjs --check",
    "test:coordination-contract": "npm run contract:candidate:check && node --test scripts/coordination-contract.test.mjs",
    "test:release": "node --test scripts/stage-npm-release.test.mjs",
    "test:repository-boundary": "node --test scripts/check-repository-boundary.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome check --diagnostic-level=error .",
    "release:verify-packages": "node scripts/verify-npm-packages.mjs",
    "docs:check": "node scripts/check-public-docs.mjs",
    "repository:check": "node scripts/check-repository-boundary.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
